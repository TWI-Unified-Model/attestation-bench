{
 "name": "demo-bank",
 "infra_domain": "trust.demobank.example",
 "workload": {
  "hint": "payments.workload.demobank.example",
  "sans": ["payments.workload.demobank.example", "spiffe://demobank.example/payments"]
 },
 "ear": {"max_age": 120, "skew": 5},
 "rrps": [
  {"name": "ca", "kind": "credential-authority", "rrp_id": "https://ca.demobank.example", "listen": "127.0.0.1:9101"},
  {"name": "vault", "kind": "secret-vault", "rrp_id": "https://vault.demobank.example", "listen": "127.0.0.1:9102"}
 ],
 "targets": [
  {
   "target": "https://ledger-db.demobank.example",
   "rrp": "ca",
   "credential_types": ["x509"],
   "freshness_kind": "present-nonce",
   "expires_in": 300,
   "verifiers": "all",
   "acceptable": ["ecdsa-p256-sha256"],
   "certificate_validity": "1h"
  },
  {
   "target": "https://fraud-api.demobank.example",
   "rrp": "vault",
   "credential_types": ["api-key"],
   "freshness_kind": "present-nonce",
   "expires_in": 300,
   "verifiers": "all",
   "acceptable": ["MLKEM768-P256+HKDF-SHA256+AES-256-GCM"],
   "secret": {
    "path": "demobank/fraud-api",
    "policy_version": "1",
    "purpose": ["authenticate"],
    "algorithm": "opaque-bearer",
    "validity_seconds": 3600
   }
  }
 ]
}
