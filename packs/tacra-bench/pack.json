{
 "name": "tacra-bench",
 "infra_domain": "bench.tacra.example",
 "workload": {
  "hint": "payments.workload.tacra.example",
  "sans": ["payments.workload.tacra.example", "spiffe://tacra.example/payments"]
 },
 "ear": {"max_age": 120, "skew": 5},
 "platform_waivers": {
  "sevsnp": {"mitigation_waivers": {"Milan": {"4": "admitted without bit 4, AMD-SB-3034"}}}
 },
 "rrps": [
  {"name": "ca", "kind": "credential-authority", "rrp_id": "https://ca1.tacra.example", "listen": "127.0.0.1:9101"},
  {
   "name": "ca-2",
   "same_as": "ca",
   "service": "ca-gateway-2",
   "rrp_id": "https://ca2.tacra.example",
   "listen": "127.0.0.1:9103"
  },
  {"name": "vault", "kind": "secret-vault", "rrp_id": "https://vault1.tacra.example", "listen": "127.0.0.1:9102"}
 ],
 "targets": [
  {
   "target": "https://db-nonce.tacra.example",
   "rrp": "ca",
   "credential_types": ["x509", "api-key"],
   "freshness_kind": "present-nonce",
   "expires_in": 300,
   "verifiers": "all",
   "acceptable": ["ecdsa-p256-sha256"],
   "certificate_validity": "1h"
  },
  {
