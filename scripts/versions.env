# Pinned versions of everything scripts/setup.sh installs into BENCH_HOME, and the Demo Bank's trust VM installs.
# Sourced by scripts/lib.sh and by e2e/bank/remote/trust.sh.
# Change a pin only together with a full rerun (make setup && make check && the hardware runs).

# Go toolchain: the oldest the modules accept (go.mod files say 1.27.3), and the one the bench is tested with.
GO_MIN=1.27.3

# The Go release the bench is built and tested with: CI uses it (.github/workflows/ci.yml, which make lint checks
# against this line), and the Demo Bank's trust VM installs its linux/amd64 archive, checked against this SHA-256
# (taken on 06.10.2026 from https://go.dev/dl/?mode=json&include=all).
GO_VERSION=1.27.3
GO_SHA256_linux_amd64=675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685

# Smallstep step CLI and step-ca, built with go install from their release tags (Apache-2.0)
STEP_CLI_MODULE=github.com/smallstep/cli/cmd/step
STEP_CA_MODULE=github.com/smallstep/certificates/cmd/step-ca
STEP_VERSION=v0.30.2

# HashiCorp Vault (BUSL-1.1): the official release zip, checked against these SHA-256 values, taken on 06.10.2026
# from https://releases.hashicorp.com/vault/2.1.1/vault_2.1.1_SHA256SUMS
VAULT_VERSION=2.1.1
VAULT_SHA256_darwin_amd64=1310ccba498a08fa9bfe09c698f54f38b6d9c2ae45bae08cf91f02bc10d295b6
VAULT_SHA256_darwin_arm64=95d100472b726d889ee380c9335191abdf5b3e6f3108cde48f4f962bfea4f009
VAULT_SHA256_linux_amd64=8aa90f9cea46f541fc7baa3d0ec692fc06afde9a248cc1f2dcac46a567c6f56b
VAULT_SHA256_linux_arm64=c2c74e111ffbc83b3d29c6f0c0215a5e53d738c9fad045f7797bcdcde3156067

# protoc plug-ins Veraison's build runs (protoc itself comes from the system: make doctor)
PROTOC_GEN_GO=google.golang.org/protobuf/cmd/protoc-gen-go@v1.28.1
PROTOC_GEN_GO_GRPC=google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.2.0
PROTOC_GEN_GO_JSON=github.com/mitchellh/protoc-gen-go-json@v1.1.0

# Python packages for the bench's scripts: scripts/requirements.txt

# Lint tools (make lint: scripts/lint.sh installs them into BENCH_HOME/tools/bin when missing). golangci-lint and
# actionlint are built with go install at these versions; ShellCheck is its release archive, checked against the
# SHA-256 GitHub publishes for it (taken on 06.10.2026 from
# https://api.github.com/repos/koalaman/shellcheck/releases/tags/v0.11.0); ruff: scripts/requirements-dev.txt.
GOLANGCI_LINT=github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0
ACTIONLINT=github.com/rhysd/actionlint/cmd/actionlint@v1.7.12
# gitleaks, the secrets scan of make lint: the release current on 07.10.2026 (v8.30.1, 2026-02-21, per the Go module
# proxy); go install checks the module against the Go checksum database.
GITLEAKS=github.com/zricethezav/gitleaks/v8@v8.30.1
SHELLCHECK_VERSION=v0.11.0
SHELLCHECK_SHA256_darwin_arm64=339b930feb1ea764467013cc1f72d09cd6b869ebf1013296ba9055ab2ffbd26f
SHELLCHECK_SHA256_darwin_amd64=c2c15e08df0e8fbc374c335b230a7ee958c313fa5714817a59aa59f1aa594f51
SHELLCHECK_SHA256_linux_amd64=b7af85e41cc99489dcc21d66c6d5f3685138f06d34651e6d34b42ec6d54fe6f6
SHELLCHECK_SHA256_linux_arm64=68a8133197a50beb8803f8d42f9908d1af1c5540d4bb05fdfca8c1fa47decefc
