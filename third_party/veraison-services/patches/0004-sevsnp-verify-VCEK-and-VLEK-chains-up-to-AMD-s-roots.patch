+// amdRoots returns AMD's roots for each product line, one per certificate
+// chain AMD's KDS publishes and go-sev-guest embeds: the ASK and ARK that
+// certify a VCEK, and the ASVK and ARK that certify a VLEK. Without them
+// go-sev-guest (from v0.15.0) trusts only its embedded defaults, which hold
+// no ASVK, and refuses every VLEK report (as AWS hosts issue).
+var amdRoots = sync.OnceValues(func() (map[string][]*trust.AMDRootCerts, error) {
+	chains := []struct {
+		productLine string
+		bundle      []byte
+	}{
+		{"Milan", trust.AskArkMilanVcekBytes},
+		{"Milan", trust.AskArkMilanVlekBytes},
+		{"Genoa", trust.AskArkGenoaVcekBytes},
+		{"Genoa", trust.AskArkGenoaVlekBytes},
+		{"Turin", trust.AskArkTurinVcekBytes},
+		{"Turin", trust.AskArkTurinVlekBytes},
+	}
+
+	roots := map[string][]*trust.AMDRootCerts{}
+	for _, c := range chains {
+		r := trust.AMDRootCertsProduct(c.productLine)
+		// the Turin VLEK chain ends with a blank line, which
+		// kds.ParseProductCertChain refuses (google/go-sev-guest#206)
+		if err := r.FromKDSCertBytes(bytes.TrimSpace(c.bundle)); err != nil {
+			return nil, fmt.Errorf("AMD %s certificate chain: %w", c.productLine, err)
+		}
+		roots[c.productLine] = append(roots[c.productLine], r)
+	}
+
+	return roots, nil
+})
+
 func validateReportIntegrity(tsm *tokens.TSMReport, certChain *sevsnp.CertificateChain) error {
 	var (
 		ark, ask, vcek, vlek []byte
 		attestation          sevsnp.Attestation
 	)
 
+	roots, err := amdRoots()
+	if err != nil {
+		return err
+	}
+
 	// options: options to use when verifying SEV-SNP evidence
 	//          not feasible to enable certificate fetching and
-	//          checking revocations as AMD KDS rate-limits requests
+	//          checking revocations as AMD KDS rate-limits requests;
+	//          the chain is checked up to AMD's roots, never to the
+	//          ASK, ASVK or ARK the evidence carries
 	options := verify.Options{
 		Getter:              trust.DefaultHTTPSGetter(),
 		Now:                 time.Now(),
 		DisableCertFetching: true,
 		CheckRevocations:    false,
+		TrustedRoots:        roots,
 	}
 
 	protoReport, err := abi.ReportToProto(tsm.OutBlob)
diff --git a/scheme/sevsnp/scheme_vlek_test.go b/scheme/sevsnp/scheme_vlek_test.go
new file mode 100644
index 0000000..bdfeccb
--- /dev/null
+++ b/scheme/sevsnp/scheme_vlek_test.go
@@ -0,0 +1,101 @@
+// Copyright 2026 Contributors to the Veraison project.
+// SPDX-License-Identifier: Apache-2.0
+package sevsnp
+
+import (
+	"bytes"
+	_ "embed"
+	"encoding/hex"
+	"encoding/pem"
+	"testing"
+
+	"github.com/google/go-sev-guest/kds"
+	"github.com/google/go-sev-guest/verify/trust"
+	"github.com/stretchr/testify/require"
+	"github.com/veraison/corim/comid"
+	"github.com/veraison/ratsd/tokens"
+	"github.com/veraison/services/vts/appraisal"
+)
+
+// A report signed with a VLEK, from an AWS EC2 c6a.large (Milan) guest. AWS
+// hosts put only the VLEK in the certificate table; the guest appended the
+// ASVK and ARK from AMD's Milan VLEK chain.
+//
+//go:embed test/evidence/sevsnp-vlek-tsm-report.cbor
+var sevsnpVLEKTSMReportCBOR []byte
+
+// REPORT_DATA of that report
+const sevsnpVLEKReportData = "6131f96c32e9cb962b4c0c7507c9c7fe36ec4c527a73a7809c786251dbe5809fa9b84cd8aec306f3d151a78acb323d8e753e085aa6f829d636792a1ae43fba44"
+
+func Test_amdRoots(t *testing.T) {
+	roots, err := amdRoots()
+	require.NoError(t, err)
+	require.Len(t, roots, 3)
+
+	for _, line := range []string{"Milan", "Genoa", "Turin"} {
+		require.Len(t, roots[line], 2, line)
+		vcek, vlek := roots[line][0].ProductCerts, roots[line][1].ProductCerts
+
+		require.Equal(t, "SEV-"+line, vcek.Ask.Subject.CommonName)
+		require.Nil(t, vcek.Asvk)
+		require.Equal(t, "SEV-VLEK-"+line, vlek.Asvk.Subject.CommonName)
+		require.Nil(t, vlek.Ask)
+
+		require.Equal(t, "ARK-"+line, vcek.Ark.Subject.CommonName)
+		require.Equal(t, vcek.Ark.Raw, vlek.Ark.Raw, line)
+	}
+}
+
+func Test_ValidateEvidenceIntegrity_VLEK(t *testing.T) {
+	_, ark, err := kds.ParseProductCertChain(trust.AskArkMilanVlekBytes)
+	require.NoError(t, err)
+	ta, err := comid.NewPKIXBase64Cert(string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: ark})))
+	require.NoError(t, err)
+	trustAnchors := []*comid.KeyTriple{{VerifKeys: comid.CryptoKeys{ta}}}
+
+	nonce, err := hex.DecodeString(sevsnpVLEKReportData)
+	require.NoError(t, err)
+
+	// the same report with one bit of MEASUREMENT (0x90) changed
+	var tsm tokens.TSMReport
+	require.NoError(t, tsm.FromCBOR(sevsnpVLEKTSMReportCBOR))
+	tsm.OutBlob = bytes.Clone(tsm.OutBlob)
+	tsm.OutBlob[0x90] ^= 1
+	changed, err := tsm.ToCBOR()
+	require.NoError(t, err)
+
+	for _, tc := range []struct {
+		name    string
+		token   []byte
+		nonce   []byte
+		wantErr string
+	}{
+		{name: "VLEK report", token: sevsnpVLEKTSMReportCBOR, nonce: nonce},
+		{
+			name:    "VLEK report, other nonce",
+			token:   sevsnpVLEKTSMReportCBOR,
+			nonce:   append([]byte{nonce[0] ^ 0xff}, nonce[1:]...),
+			wantErr: "nonce in the evidence doesn't match",
+		},
+		{
+			name:    "VLEK report, MEASUREMENT changed",
+			token:   changed,
+			nonce:   nonce,
+			wantErr: "report signature verification error",
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			evidence := appraisal.Evidence{
+				Data:      tc.token,
+				MediaType: EvidenceMediaTypeTSMCbor,
+				Nonce:     tc.nonce,
+			}
+			err := NewImplementation().ValidateEvidenceIntegrity(&evidence, trustAnchors, nil)
+			if tc.wantErr != "" {
+				require.ErrorContains(t, err, tc.wantErr)
+				return
+			}
+			require.NoError(t, err)
+		})
+	}
+}
