+// unreachableGetter fetches over HTTPS as the scheme's getter does, but sends its connections to a local port that
+// nothing listens on, as when the KDS cannot be reached: the error is the network's own.
+type unreachableGetter struct{ client *http.Client }
+
+func newUnreachableGetter(t *testing.T) unreachableGetter {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	addr := l.Addr().String()
+	require.NoError(t, l.Close()) // nothing listens there any more
+	dial := func(ctx context.Context, network, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, network, addr)
+	}
+	return unreachableGetter{&http.Client{Transport: &http.Transport{DialContext: dial}, Timeout: 10 * time.Second}}
+}
 
-func (failingGetter) Get(url string) ([]byte, error) { return nil, fmt.Errorf("unreachable: %s", url) }
+func (g unreachableGetter) Get(url string) ([]byte, error) {
+	resp, err := g.client.Get(url)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	return io.ReadAll(resp.Body)
+}
 
