diff --git a/scheme/sevsnp/p0.go b/scheme/sevsnp/p0.go
new file mode 100644
index 0000000..37b736f
--- /dev/null
+++ b/scheme/sevsnp/p0.go
@@ -0,0 +1,117 @@
+// Copyright 2026 Contributors to the Veraison project.
+// SPDX-License-Identifier: Apache-2.0
+
+package sevsnp
+
+import (
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/go-sev-guest/verify/trust"
+	"github.com/veraison/corim/comid"
+	"github.com/veraison/services/log"
+)
+
+// guestPolicyViolation returns why the guest policy of the report (MKey 2, the POLICY field as a big-endian raw
+// value) is one no reference value can make acceptable, or "" if it is not. AMD SEV-SNP Firmware ABI, Table 12:
+// DEBUG (bit 19) lets the hypervisor debug the guest; MIGRATE_MA (bit 18) associates it with a migration agent;
+// bit 17 is reserved and must be one; bits 63:26 are reserved and must be zero.
+func guestPolicyViolation(ev map[uint64]comid.Measurement) string {
+	m, ok := ev[mKeyPolicy]
+	if !ok || m.Val.RawValue == nil {
+		return "the report's POLICY is missing"
+	}
+	b, err := m.Val.RawValue.GetBytes()
+	if err != nil || len(b) != 8 {
+		return "the report's POLICY is not 8 octets"
+	}
+	var policy uint64
+	for _, x := range b {
+		policy = policy<<8 | uint64(x)
+	}
+	switch {
+	case policy>>19&1 == 1:
+		return fmt.Sprintf("POLICY %#x: DEBUG is set", policy)
+	case policy>>18&1 == 1:
+		return fmt.Sprintf("POLICY %#x: MIGRATE_MA is set", policy)
+	case policy>>17&1 != 1 || policy>>26 != 0:
+		return fmt.Sprintf("POLICY %#x: bit 17 must be one and bits 63:26 zero", policy)
+	}
+	return ""
+}
+
+// crlCache keeps each AMD CRL, by distribution point, until its nextUpdate: the KDS publishes one CRL per product
+// line and key type and rate-limits identical requests, so a CRL is fetched once per validity period, not per
+// appraisal.
+var crlCache = struct {
+	sync.Mutex
+	m map[string]*x509.RevocationList
+}{m: map[string]*x509.RevocationList{}}
+
+// ErrRevocation is wrapped by every failure of the revocation check; the check fails closed.
+var ErrRevocation = errors.New("revocation check failed")
+
+// trustedIssuer returns, among AMD's roots, the intermediate (an ASK, or an ASVK for a VLEK) that signed the
+// report's certificate, and the ARK that certifies it: the pair the report's chain was verified against, and so the
+// one whose revocation matters.
+func trustedIssuer(roots map[string][]*trust.AMDRootCerts, leaf *x509.Certificate) (ark, inter *x509.Certificate, err error) {
+	for _, line := range roots {
+		for _, r := range line {
+			if r == nil || r.ProductCerts == nil || r.ProductCerts.Ark == nil {
+				continue
+			}
+			for _, c := range []*x509.Certificate{r.ProductCerts.Ask, r.ProductCerts.Asvk} {
+				if c != nil && leaf.CheckSignatureFrom(c) == nil {
+					return r.ProductCerts.Ark, c, nil
+				}
+			}
+		}
+	}
+	return nil, nil, fmt.Errorf("%w: no intermediate among AMD's roots signed the report's certificate", ErrRevocation)
+}
+
+// intermediateNotRevoked checks the intermediate of the chain (the ASK, or the ASVK for a VLEK) against the CRL at
+// its distribution point, which must be on AMD's KDS: the CRL must be signed by the ARK, and now must lie in
+// [thisUpdate, nextUpdate) (AMD VCEK Certificate and KDS Interface Specification 57230, Tables 8 and 15; VLEK
+// Certificate Definition 58369). The ARK is the one already compared with the provisioned trust anchor.
+func intermediateNotRevoked(ark, inter *x509.Certificate, getter trust.HTTPSGetter, now time.Time) error {
+	if len(inter.CRLDistributionPoints) != 1 || !strings.HasPrefix(inter.CRLDistributionPoints[0], "https://kdsintf.amd.com/") {
+		return fmt.Errorf("%w: the intermediate's CRL distribution points are %v", ErrRevocation, inter.CRLDistributionPoints)
+	}
+	url := inter.CRLDistributionPoints[0]
+	crlCache.Lock()
+	defer crlCache.Unlock()
+	crl := crlCache.m[url]
+	if crl == nil || now.Before(crl.ThisUpdate) || !now.Before(crl.NextUpdate) {
+		body, err := getter.Get(url)
+		if err != nil {
+			return fmt.Errorf("%w: fetching %s: %v", ErrRevocation, url, err)
+		}
+		if crl, err = x509.ParseRevocationList(body); err != nil {
+			return fmt.Errorf("%w: %s: %v", ErrRevocation, url, err)
+		}
+		if err := crl.CheckSignatureFrom(ark); err != nil {
+			return fmt.Errorf("%w: the CRL at %s is not signed by the ARK: %v", ErrRevocation, url, err)
+		}
+		if now.Before(crl.ThisUpdate) || !now.Before(crl.NextUpdate) {
+			return fmt.Errorf("%w: the CRL at %s is not current (%s to %s)", ErrRevocation, url,
+				crl.ThisUpdate.UTC().Format(time.RFC3339), crl.NextUpdate.UTC().Format(time.RFC3339))
+		}
+		crlCache.m[url] = crl
+	}
+	for _, r := range crl.RevokedCertificateEntries {
+		if r.SerialNumber.Cmp(inter.SerialNumber) == 0 {
+			return fmt.Errorf("%w: the intermediate %x was revoked at %s", ErrRevocation, inter.SerialNumber,
+				r.RevocationTime.UTC().Format(time.RFC3339))
+		}
+	}
+	// one line per appraisal, so that the log of each one shows the check and the CRL it used
+	log.Named(Descriptor.Name).Infof("%s (serial %x) is not on AMD's CRL %s of %s (next update %s)",
+		inter.Subject.CommonName, inter.SerialNumber, url, crl.ThisUpdate.UTC().Format(time.RFC3339),
+		crl.NextUpdate.UTC().Format(time.RFC3339))
+	return nil
+}
diff --git a/scheme/sevsnp/p0_test.go b/scheme/sevsnp/p0_test.go
new file mode 100644
index 0000000..e3dd91e
--- /dev/null
+++ b/scheme/sevsnp/p0_test.go
@@ -0,0 +1,232 @@
+// Copyright 2026 Contributors to the Veraison project.
+// SPDX-License-Identifier: Apache-2.0
+
+package sevsnp
+
+import (
+	"bytes"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"math/big"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"github.com/veraison/corim/comid"
+	"github.com/veraison/corim/corim"
+	"github.com/veraison/ear"
+	"github.com/veraison/services/vts/appraisal"
+)
+
+// test/crl/ holds AMD's CRLs and VCEK chains for Milan, Genoa and Turin as the KDS served them on 30 September 2026
+// (CRL this update 2026-09-22, next update 2026-11-09; the Genoa CRL revokes serial 020001). The tests appraise at a
+// fixed time inside that window and never reach the network.
+var snapshotTime = time.Date(2026, 9, 30, 12, 0, 0, 0, time.UTC)
+
+type snapshotGetter struct{ calls map[string]int }
+
+func (g *snapshotGetter) Get(url string) ([]byte, error) {
+	g.calls[url]++
+	for _, p := range []string{"Milan", "Genoa", "Turin"} {
+		// The KDS serves the ARK's one CRL at both distribution points, the VCEK's and the VLEK's (test/crl/SOURCES.md).
+		if url == "https://kdsintf.amd.com/vcek/v1/"+p+"/crl" || url == "https://kdsintf.amd.com/vlek/v1/"+p+"/crl" {
+			return os.ReadFile("test/crl/kds-vcek-crl-" + strings.ToLower(p) + "-20260930.der")
+		}
+	}
+	return nil, fmt.Errorf("no snapshot for %s", url)
+}
+
+var snapshot = &snapshotGetter{calls: map[string]int{}}
+
+func TestMain(m *testing.M) {
+	crlGetter = snapshot
+	now = func() time.Time { return snapshotTime }
+	os.Exit(m.Run())
+}
+
+func chainCerts(t *testing.T, product string) (ask, ark *x509.Certificate) {
+	t.Helper()
+	raw, err := os.ReadFile("test/crl/kds-vcek-cert_chain-" + product + ".pem")
+	require.NoError(t, err)
+	var certs []*x509.Certificate
+	for {
+		var b *pem.Block
+		b, raw = pem.Decode(raw)
+		if b == nil {
+			break
+		}
+		c, err := x509.ParseCertificate(b.Bytes)
+		require.NoError(t, err)
+		certs = append(certs, c)
+	}
+	require.Len(t, certs, 2)
+	return certs[0], certs[1]
+}
+
+func resetCache() {
+	crlCache.Lock()
+	crlCache.m = map[string]*x509.RevocationList{}
+	crlCache.Unlock()
+}
+
+func TestIntermediateNotRevoked(t *testing.T) {
+	resetCache()
+	ask, ark := chainCerts(t, "milan")
+	require.NoError(t, intermediateNotRevoked(ark, ask, snapshot, snapshotTime), "the Milan ASK 010001")
+	before := snapshot.calls["https://kdsintf.amd.com/vcek/v1/Milan/crl"]
+	require.NoError(t, intermediateNotRevoked(ark, ask, snapshot, snapshotTime))
+	require.Equal(t, before, snapshot.calls["https://kdsintf.amd.com/vcek/v1/Milan/crl"], "the CRL is fetched once per validity period")
+
+	gask, gark := chainCerts(t, "genoa")
+	require.NoError(t, intermediateNotRevoked(gark, gask, snapshot, snapshotTime), "the Genoa ASK 020002")
+	revoked := *gask
+	revoked.SerialNumber = big.NewInt(0x020001)
+	err := intermediateNotRevoked(gark, &revoked, snapshot, snapshotTime)
+	require.ErrorIs(t, err, ErrRevocation)
+	require.Contains(t, err.Error(), "was revoked")
+
+	// after the CRL's nextUpdate, a CRL that is no longer current is refused (fail closed)
+	resetCache()
+	err = intermediateNotRevoked(ark, ask, snapshot, time.Date(2026, 11, 10, 0, 0, 0, 0, time.UTC))
+	require.ErrorIs(t, err, ErrRevocation)
+	require.Contains(t, err.Error(), "not current")
+
+	// the Genoa CRL checked against the Milan ARK: not signed by it
+	resetCache()
+	wrongPoint := *ask
+	wrongPoint.CRLDistributionPoints = []string{"https://kdsintf.amd.com/vcek/v1/Genoa/crl"}
+	err = intermediateNotRevoked(ark, &wrongPoint, snapshot, snapshotTime)
+	require.ErrorIs(t, err, ErrRevocation)
+	require.Contains(t, err.Error(), "not signed by the ARK")
+
+	// a distribution point outside AMD's KDS
+	elsewhere := *ask
+	elsewhere.CRLDistributionPoints = []string{"https://crl.example/milan.crl"}
+	require.ErrorIs(t, intermediateNotRevoked(ark, &elsewhere, snapshot, snapshotTime), ErrRevocation)
+	resetCache()
+}
+
+// A CRL made by someone else under ARK-Milan's name is refused.
+func TestForgedCRL(t *testing.T) {
+	resetCache()
+	ask, ark := chainCerts(t, "milan")
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	issuer := &x509.Certificate{Subject: ark.Subject, SubjectKeyId: []byte{1, 2, 3, 4}, KeyUsage: x509.KeyUsageCRLSign,
+		PublicKey: &key.PublicKey}
+	der, err := x509.CreateRevocationList(rand.Reader, &x509.RevocationList{Number: big.NewInt(12),
+		ThisUpdate: snapshotTime.Add(-time.Hour), NextUpdate: snapshotTime.Add(24 * time.Hour)}, issuer, key)
+	require.NoError(t, err)
+	forged := forgedGetter{der}
+	err = intermediateNotRevoked(ark, ask, forged, snapshotTime)
+	require.ErrorIs(t, err, ErrRevocation)
+	require.Contains(t, err.Error(), "not signed by the ARK")
+	resetCache()
+}
+
+type forgedGetter struct{ der []byte }
+
+func (g forgedGetter) Get(string) ([]byte, error) { return g.der, nil }
+
+func policyMeasurements(policy uint64) map[uint64]comid.Measurement {
+	b := make([]byte, 8)
+	binary.BigEndian.PutUint64(b, policy)
+	m := comid.MustNewUintMeasurement(uint(mKeyPolicy))
+	m.SetRawValueBytes(b, nil)
+	return map[uint64]comid.Measurement{mKeyPolicy: *m}
+}
+
+func TestGuestPolicyViolation(t *testing.T) {
+	require.Equal(t, "", guestPolicyViolation(policyMeasurements(0x30000)), "the pilot's POLICY")
+	for policy, want := range map[uint64]string{0x30000 | 1<<19: "DEBUG", 0x30000 | 1<<18: "MIGRATE_MA",
+		0x10000: "bit 17", 0x30000 | 1<<26: "bit 17"} {
+		require.Contains(t, guestPolicyViolation(policyMeasurements(policy)), want, "POLICY %#x", policy)
+	}
+	require.NotEqual(t, "", guestPolicyViolation(map[uint64]comid.Measurement{}))
+	require.False(t, errors.Is(nil, ErrRevocation))
+}
+
+type failingGetter struct{}
+
+func (failingGetter) Get(url string) ([]byte, error) { return nil, fmt.Errorf("unreachable: %s", url) }
+
+// The evidence of the other tests passes only because the snapshot CRL is served; with the KDS unreachable and
+// nothing cached, the same evidence is refused: the revocation check is on the path and fails closed.
+func TestIntegrityNeedsTheCRL(t *testing.T) {
+	var (
+		endCorim     corim.UnsignedCorim
+		endComid     comid.Comid
+		trustAnchors []*comid.KeyTriple
+	)
+	require.NoError(t, endCorim.FromCBOR(sevsnpCorimValidEndorsements))
+	require.NoError(t, endComid.FromCBOR(endCorim.Tags[1].Content))
+	keyTriples := *endComid.Triples.AttestVerifKeys
+	trustAnchors = append(trustAnchors, &keyTriples[0])
+	nonce, err := hex.DecodeString("4d4944424e48323869696f69736a5079787878787878787878787878787878784d4944424e48323869696f69736a507978787878787878787878787878787878")
+	require.NoError(t, err)
+	evidence := appraisal.Evidence{Data: sevsnpTSMReportCBOR, MediaType: EvidenceMediaTypeTSMCbor, Nonce: nonce}
+
+	resetCache()
+	require.NoError(t, NewImplementation().ValidateEvidenceIntegrity(&evidence, trustAnchors, nil), "with the snapshot CRL")
+
+	resetCache()
+	crlGetter = failingGetter{}
+	defer func() { crlGetter = snapshot; resetCache() }()
+	err = NewImplementation().ValidateEvidenceIntegrity(&evidence, trustAnchors, nil)
+	require.ErrorIs(t, err, ErrRevocation)
+	t.Logf("KDS unreachable: %v", err)
+}
+
+// The claims of Test_AppraiseClaims_ok with POLICY.DEBUG set: whatever else matches, the result is not affirming.
+func TestAppraiseClaimsRefusesDebug(t *testing.T) {
+	var claims map[string]any
+	require.NoError(t, json.Unmarshal(sevsnpRatsdClaimsMapJson, &claims))
+	tags := claims["tags"].([]any)
+	raw, err := base64.StdEncoding.DecodeString(tags[0].(string))
+	require.NoError(t, err)
+	// MKey 2, POLICY 0x30000 as tag 560 around an 8-octet byte string; set bit 19 (DEBUG)
+	policy := []byte{0xd9, 0x02, 0x30, 0x48, 0, 0, 0, 0, 0, 0x03, 0, 0}
+	require.Equal(t, 1, bytes.Count(raw, policy))
+	raw = bytes.Replace(raw, policy, []byte{0xd9, 0x02, 0x30, 0x48, 0, 0, 0, 0, 0, 0x0b, 0, 0}, 1)
+	tags[0] = base64.StdEncoding.EncodeToString(raw)
+
+	var endCorim corim.UnsignedCorim
+	var endComid comid.Comid
+	require.NoError(t, endCorim.FromCBOR(sevsnpCorimValidEndorsements))
+	require.NoError(t, endComid.FromCBOR(endCorim.Tags[0].Content))
+	result, err := NewImplementation().AppraiseClaims(claims, []*comid.ValueTriple{&endComid.Triples.ReferenceValues.Values[0]})
+	require.NoError(t, err)
+	sub := result.Submods["SEVSNP"]
+	require.Equal(t, ear.TrustTierContraindicated, *sub.Status)
+	require.Equal(t, ear.UnsupportableConfigClaim, sub.TrustVector.Configuration)
+}
+
+// The intermediate whose revocation is checked is the one among AMD's roots that signed the report's certificate; a
+// certificate none of them signed has no such intermediate, and the check fails closed.
+func TestTrustedIssuerUnknownLeaf(t *testing.T) {
+	roots, err := amdRoots()
+	require.NoError(t, err)
+	key, err := ecdsa.GenerateKey(elliptic.P384(), rand.Reader)
+	require.NoError(t, err)
+	tmpl := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "SEV-VCEK"},
+		NotBefore: snapshotTime.Add(-time.Hour), NotAfter: snapshotTime.Add(time.Hour)}
+	der, err := x509.CreateCertificate(rand.Reader, tmpl, tmpl, &key.PublicKey, key)
+	require.NoError(t, err)
+	leaf, err := x509.ParseCertificate(der)
+	require.NoError(t, err)
+	_, _, err = trustedIssuer(roots, leaf)
+	require.ErrorIs(t, err, ErrRevocation)
+}
diff --git a/scheme/sevsnp/scheme.go b/scheme/sevsnp/scheme.go
index 8600c8a..3cfdfe3 100644
--- a/scheme/sevsnp/scheme.go
+++ b/scheme/sevsnp/scheme.go
@@ -265,6 +265,14 @@ func (o *Implementation) AppraiseClaims(
 		o.logger.Debug("failed to match evidence to reference values!")
 	}
 
+	// POLICY is skipped in the matching (tryMatchEvidence), but some policies no reference value can make
+	// acceptable: a guest the hypervisor may debug, or one bound to a migration agent. Such a guest is not
+	// affirmed, whatever else matched.
+	if why := guestPolicyViolation(evMeasurements); why != "" {
+		o.logger.Infof("guest policy refused: %s", why)
+		appraisal.TrustVector.Configuration = ear.UnsupportableConfigClaim
+	}
+
 	appraisal.UpdateStatusFromTrustVector()
 	appraisal.VeraisonAnnotatedEvidence = &claims
 
@@ -741,12 +749,16 @@ func validateReportIntegrity(tsm *tokens.TSMReport, certChain *sevsnp.Certificat
 
 	// options: options to use when verifying SEV-SNP evidence
 	//          not feasible to enable certificate fetching and
-	//          checking revocations as AMD KDS rate-limits requests;
-	//          the chain is checked up to AMD's roots, never to the
-	//          ASK, ASVK or ARK the evidence carries
+	//          checking revocations here as AMD KDS rate-limits requests
+	//          (go-sev-guest would fetch the CRL for every report); the
+	//          chain is checked up to AMD's roots, never to the ASK, ASVK
+	//          or ARK the evidence carries, and the revocation check is
+	//          done below, on the intermediate among AMD's roots that
+	//          signed the report's certificate, with a CRL kept until its
+	//          nextUpdate
 	options := verify.Options{
 		Getter:              trust.DefaultHTTPSGetter(),
-		Now:                 time.Now(),
+		Now:                 now(),
 		DisableCertFetching: true,
 		CheckRevocations:    false,
 		TrustedRoots:        roots,
@@ -797,5 +809,31 @@ func validateReportIntegrity(tsm *tokens.TSMReport, certChain *sevsnp.Certificat
 		return handler.BadEvidence(err)
 	}
 
+	// Revocation of the chain's intermediate, against the product line's CRL, fetched once per validity period
+	// (p0.go). The chain was verified above up to AMD's roots, so the intermediate checked is the one among those
+	// roots that signed the report's certificate, with the ARK that certifies it; the ASK and ARK the evidence
+	// carries play no part.
+	leafDER := vcek
+	if signerInfo.SigningKey == ReportSigningKeyVlek {
+		leafDER = vlek
+	}
+	leaf, err := x509.ParseCertificate(leafDER)
+	if err != nil {
+		return handler.BadEvidence(fmt.Errorf("can't parse the report's certificate: %w", err))
+	}
+	arkCert, interCert, err := trustedIssuer(roots, leaf)
+	if err != nil {
+		return handler.BadEvidence(err)
+	}
+	if err := intermediateNotRevoked(arkCert, interCert, crlGetter, options.Now); err != nil {
+		return handler.BadEvidence(err)
+	}
+
 	return nil
 }
+
+// crlGetter fetches the CRLs, and now is the time of the appraisal; tests replace both.
+var (
+	crlGetter trust.HTTPSGetter = trust.DefaultHTTPSGetter()
+	now                         = time.Now
+)
diff --git a/scheme/sevsnp/test/crl/SOURCES.md b/scheme/sevsnp/test/crl/SOURCES.md
new file mode 100644
index 0000000..be1bc70
--- /dev/null
+++ b/scheme/sevsnp/test/crl/SOURCES.md
@@ -0,0 +1,19 @@
