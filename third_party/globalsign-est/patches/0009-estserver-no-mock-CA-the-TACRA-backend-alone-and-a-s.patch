--- /dev/null
+++ b/cmd/estserver/config_test.go
@@ -0,0 +1,72 @@
+package main
+
+import (
+	"encoding/json"
+	"os"
+	"strings"
+	"testing"
+)
+
+// The configuration's rules, on the sample, the example, and the sample with one field changed. The server itself
+// starts with the bench's configuration in every run of the bench.
+
+func TestSampleAndExample(t *testing.T) {
+	example, err := os.ReadFile("../../estserver.json.example")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for name, data := range map[string][]byte{"sample": []byte(sample), "example": example} {
+		cfg, err := parseConfig(data)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		if len(cfg.Tacra.Verifiers) == 0 || len(cfg.Tacra.RRPs) == 0 || len(cfg.Tacra.Targets) == 0 {
+			t.Fatalf("%s: a tacra section without verifiers, RRPs or Targets", name)
+		}
+	}
+}
+
+// changed is the sample with one change made.
+func changed(t *testing.T, change func(map[string]any)) []byte {
+	t.Helper()
+	var m map[string]any
+	if err := json.Unmarshal([]byte(sample), &m); err != nil {
+		t.Fatal(err)
+	}
+	change(m)
+	b, err := json.Marshal(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+func TestRefused(t *testing.T) {
+	section := func(m map[string]any, k string) map[string]any { return m[k].(map[string]any) }
+	for _, c := range []struct {
+		name string
+		data []byte
+		want string
+	}{
+		{"the mock CA of the server this one is forked from", changed(t, func(m map[string]any) {
+			m["mock_ca"] = map[string]any{"certificates": "/path/to/CA/certificates.pem", "private_key": "/path/to/CA/private/key.pem"}
+		}), `unknown field "mock_ca"`},
+		{"its mock attested CA", changed(t, func(m map[string]any) {
+			m["attest"] = map[string]any{"trusted_provider_public_key": "/path/to/provider/public/key.pem"}
+		}), `unknown field "attest"`},
+		{"no tacra section", changed(t, func(m map[string]any) { delete(m, "tacra") }), "no tacra section"},
+		{"no tls section", changed(t, func(m map[string]any) { delete(m, "tls") }), "no tls section"},
+		{"no server key", changed(t, func(m map[string]any) { delete(section(m, "tls"), "private_key") }),
+			"tls: listen_address, certificates and private_key are required"},
+		{"an RRP's field misspelt", changed(t, func(m map[string]any) {
+			rrp := section(section(section(m, "tacra"), "rrps"), "ca")
+			rrp["rrpid"] = rrp["rrp_id"]
+			delete(rrp, "rrp_id")
+		}), `unknown field "rrpid"`},
+		{"a second object after the first", []byte(sample + sample), "data after the configuration object"},
+	} {
+		if _, err := parseConfig(c.data); err == nil || !strings.Contains(err.Error(), c.want) {
+			t.Errorf("%s: got %v, want an error with %q", c.name, err, c.want)
+		}
+	}
+}
