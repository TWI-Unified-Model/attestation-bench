+
+// parseConfig decodes a configuration strictly: an unknown field, or anything
+// after the configuration object, is an error.
+func parseConfig(data []byte) (*config, error) {
+	dec := json.NewDecoder(bytes.NewReader(data))
+	dec.DisallowUnknownFields()
+
 	var cfg config
-	if err := json.Unmarshal(data, &cfg); err != nil {
+	if err := dec.Decode(&cfg); err != nil {
 		return nil, err
 	}
+	if _, err := dec.Token(); err != io.EOF {
+		return nil, errors.New("data after the configuration object")
+	}
+
+	switch {
+	case cfg.TLS == nil:
+		return nil, errors.New("no tls section: the server's certificates and private key are required")
+	case cfg.TLS.ListenAddr == "" || cfg.TLS.Certs == "" || cfg.TLS.Key == "":
+		return nil, errors.New("tls: listen_address, certificates and private_key are required")
+	case cfg.Tacra == nil:
+		return nil, errors.New("no tacra section: the server provisions credentials only with the TACRA backend")
+	}
 
 	return &cfg, nil
 }
 
