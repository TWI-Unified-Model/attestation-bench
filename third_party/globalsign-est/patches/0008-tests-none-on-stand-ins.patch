-			t.Fatalf("%q: enroll: %v", model, err)
-		}
-		if len(f.enrollLeg) != 1 {
-			t.Fatalf("%q: the RRP received %d second legs", model, len(f.enrollLeg))
-		}
-		leg := f.enrollLeg[0]
-		if model == backgroundCheck {
-			if len(f.verifier) != 0 {
