From 182d25d32c28b99dac44b7bf665ad2300da674bd Mon Sep 17 00:00:00 2001
From: Serhii Nikolaichuk <nikolaichuk.s.f@gmail.com>
Date: Wed, 7 Oct 2026 16:20:43 -0500
Subject: [PATCH] tacra: a session per Target for a present-epoch Handle, which
 every Target shares

The server keeps, between attest-initiate and the second leg, the session
each Handle belongs to, and refuses a second leg whose Target, Credential
Type or Freshness Kind is not that session's. It kept one session per
Handle. A present-nonce Handle is one Target's, but a present-epoch
Handle is the deployment's epoch, the same for every Target: an
attest-initiate for a second Target replaced the first Target's session,
and the first Target's second leg was refused (403). Found by an attack
run of 7 October 2026 that asked for db-epoch and ledger-epoch before
offering either's Evidence; two workloads doing the same at once would
meet it too.

The server now keeps a session per Target, Credential Type and kind
under each Handle, replacing only an earlier one of the same three, and
forgets expired ones; a present-nonce Handle still serves one second leg.
session_test.go covers the shared epoch, the single use, and an expired
or unknown Handle.
---
 internal/tacra/backend.go      | 74 +++++++++++++++++++++++---------
 internal/tacra/session_test.go | 78 ++++++++++++++++++++++++++++++++++
 2 files changed, 132 insertions(+), 20 deletions(-)
 create mode 100644 internal/tacra/session_test.go

diff --git a/internal/tacra/backend.go b/internal/tacra/backend.go
index 6d83150..5668267 100644
--- a/internal/tacra/backend.go
+++ b/internal/tacra/backend.go
@@ -82,8 +82,11 @@ type Backend struct {
 	verifiers map[string]*http.Client // by name
 	rrps      map[string]*http.Client
 
-	mu       sync.Mutex
-	sessions map[string]session // present-* Handles returned by attest-initiate
+	mu sync.Mutex
+	// present-* Handles returned by attest-initiate, by Handle: a present-nonce Handle is one Target's, but a
+	// present-epoch Handle is the epoch, which every Target of the deployment shares, so it keeps a session per Target
+	// and Credential Type that asked
+	sessions map[string][]session
 }
 
 // client is TLS 1.3 to a server certified by caPath, presenting this server's client certificate when one is
@@ -110,7 +113,7 @@ func (c *Config) client(caPath string) (*http.Client, error) {
 
 // New builds the backend from its configuration.
 func New(cfg Config) (*Backend, error) {
-	b := &Backend{cfg: cfg, rrps: map[string]*http.Client{}, verifiers: map[string]*http.Client{}, sessions: map[string]session{}}
+	b := &Backend{cfg: cfg, rrps: map[string]*http.Client{}, verifiers: map[string]*http.Client{}, sessions: map[string][]session{}}
 	var err error
 	for name, v := range cfg.Verifiers {
 		if v.URL == "" || v.Provider == "" {
@@ -259,16 +262,8 @@ func (b *Backend) InitiateRemoteAttestation(ctx context.Context, target, credent
 		return nil, fail(http.StatusBadGateway, "RRP %s: Handle is not base64url", name)
 	}
 	if len(handle) > 0 {
-		b.mu.Lock()
-		now := time.Now()
-		for k, s := range b.sessions {
-			if now.After(s.expires) {
-				delete(b.sessions, k)
-			}
-		}
-		b.sessions[hex.EncodeToString(handle)] = session{target, credentialType, name, g.FreshnessKind,
-			now.Add(time.Duration(g.ExpiresIn) * time.Second)}
-		b.mu.Unlock()
+		b.remember(hex.EncodeToString(handle), session{target, credentialType, name, g.FreshnessKind,
+			time.Now().Add(time.Duration(g.ExpiresIn) * time.Second)})
 	}
 	return &est.AttestationInitiateResponse{FreshnessKind: g.FreshnessKind, Handle: handle, RRPID: g.RRPID,
 		ExpiresIn: g.ExpiresIn, MaxAge: g.MaxAge, AcceptableEvidence: b.cfg.AcceptableEvidence,
@@ -276,23 +271,62 @@ func (b *Backend) InitiateRemoteAttestation(ctx context.Context, target, credent
 		Mechanism: g.Mode}, nil
 }
 
-// correlate refuses a second leg that does not belong to the attest-initiate that returned its Handle.
+// remember keeps the session of an attest-initiate under its Handle, in place of an earlier one for the same Target,
+// Credential Type and kind, and forgets every expired session.
+func (b *Backend) remember(key string, s session) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	now := time.Now()
+	for k, ss := range b.sessions {
+		live := ss[:0]
+		for _, x := range ss {
+			if !now.After(x.expires) && !(k == key && x.target == s.target && x.credentialType == s.credentialType && x.kind == s.kind) {
+				live = append(live, x)
+			}
+		}
+		if len(live) == 0 {
+			delete(b.sessions, k)
+		} else {
+			b.sessions[k] = live
+		}
+	}
+	b.sessions[key] = append(b.sessions[key], s)
+}
+
+// correlate refuses a second leg that does not belong to an attest-initiate that returned its Handle for its Target,
+// Credential Type and kind.
 func (b *Backend) correlate(kind string, handle []byte, target, credentialType string) error {
+	return b.correlateKey(kind, hex.EncodeToString(handle), target, credentialType)
+}
+
+func (b *Backend) correlateKey(kind, key, target, credentialType string) error {
 	if kind != est.FreshnessPresentNonce && kind != est.FreshnessPresentEpoch {
 		return nil // no Handle was returned; the RRP checks the freshness element
 	}
 	b.mu.Lock()
 	defer b.mu.Unlock()
-	key := hex.EncodeToString(handle)
-	s, ok := b.sessions[key]
-	if !ok || time.Now().After(s.expires) {
+	now, live, match := time.Now(), 0, -1
+	for i, s := range b.sessions[key] {
+		if now.After(s.expires) {
+			continue
+		}
+		live++
+		if s.target == target && s.credentialType == credentialType && s.kind == kind {
+			match = i
+		}
+	}
+	if live == 0 {
 		return fail(http.StatusConflict, "no attest-initiate returned this Handle, or it expired")
 	}
-	if s.target != target || s.credentialType != credentialType || s.kind != kind {
+	if match < 0 {
 		return fail(http.StatusForbidden, "Target, Credential Type or Freshness Kind differ from the attest-initiate")
 	}
-	if kind == est.FreshnessPresentNonce {
-		delete(b.sessions, key)
+	if kind == est.FreshnessPresentNonce { // single use
+		ss := b.sessions[key]
+		b.sessions[key] = append(ss[:match:match], ss[match+1:]...)
+		if len(b.sessions[key]) == 0 {
+			delete(b.sessions, key)
+		}
 	}
 	return nil
 }
diff --git a/internal/tacra/session_test.go b/internal/tacra/session_test.go
new file mode 100644
index 0000000..140af1c
--- /dev/null
+++ b/internal/tacra/session_test.go
@@ -0,0 +1,78 @@
+package tacra
+
+import (
+	"encoding/hex"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/globalsign/est"
+)
+
+// The sessions the EST server keeps between attest-initiate and the second leg. The case that showed the fault, an
+// attack run of 7 October 2026: attest-initiate for https://db-epoch.tacra.example (x509) and then for
+// https://ledger-epoch.tacra.example (api-key) returned the same Handle, the deployment's epoch, and the Enrollment
+// at db-epoch that followed was refused (403) because the second session had replaced the first.
+
+func status(err error) int {
+	if err == nil {
+		return http.StatusOK
+	}
+	if e, ok := err.(*httpError); ok {
+		return e.StatusCode()
+	}
+	return 0
+}
+
+func TestEpochSharedByTargets(t *testing.T) {
+	b := &Backend{sessions: map[string][]session{}}
+	key, live := hex.EncodeToString([]byte("an epoch marker of 32 octets....")), time.Now().Add(5*time.Minute)
+	b.remember(key, session{"https://db-epoch.tacra.example", "x509", "ca", est.FreshnessPresentEpoch, live})
+	b.remember(key, session{"https://ledger-epoch.tacra.example", "api-key", "vault", est.FreshnessPresentEpoch, live})
+	for range 2 { // an epoch serves every second leg while it lives
+		for _, c := range []struct{ target, ctype string }{
+			{"https://db-epoch.tacra.example", "x509"},
+			{"https://ledger-epoch.tacra.example", "api-key"},
+		} {
+			if got := status(b.correlateKey(est.FreshnessPresentEpoch, key, c.target, c.ctype)); got != http.StatusOK {
+				t.Fatalf("%s: %d, want 200", c.target, got)
+			}
+		}
+	}
+	if got := status(b.correlateKey(est.FreshnessPresentEpoch, key, "https://db-nonce.tacra.example", "x509")); got != http.StatusForbidden {
+		t.Fatalf("a Target that asked for no Initiate: %d, want 403", got)
+	}
+	// asking again for the same Target replaces its session rather than adding one
+	b.remember(key, session{"https://db-epoch.tacra.example", "x509", "ca", est.FreshnessPresentEpoch, live})
+	if n := len(b.sessions[key]); n != 2 {
+		t.Fatalf("%d sessions for the epoch, want 2", n)
+	}
+}
+
+func TestNonceSingleUse(t *testing.T) {
+	b := &Backend{sessions: map[string][]session{}}
+	key := "a present-nonce Handle"
+	b.remember(key, session{"https://db-nonce.tacra.example", "x509", "ca", est.FreshnessPresentNonce, time.Now().Add(time.Minute)})
+	if got := status(b.correlateKey(est.FreshnessPresentNonce, key, "https://db-nonce.tacra.example", "api-key")); got != http.StatusForbidden {
+		t.Fatalf("another Credential Type: %d, want 403", got)
+	}
+	if got := status(b.correlateKey(est.FreshnessPresentNonce, key, "https://db-nonce.tacra.example", "x509")); got != http.StatusOK {
+		t.Fatalf("its own second leg: %d, want 200", got)
+	}
+	if got := status(b.correlateKey(est.FreshnessPresentNonce, key, "https://db-nonce.tacra.example", "x509")); got != http.StatusConflict {
+		t.Fatalf("the Handle again: %d, want 409", got)
+	}
+}
+
+func TestExpiredOrUnknown(t *testing.T) {
+	b := &Backend{sessions: map[string][]session{}}
+	b.remember("old", session{"https://db-nonce.tacra.example", "x509", "ca", est.FreshnessPresentNonce, time.Now().Add(-time.Second)})
+	for _, key := range []string{"old", "never returned"} {
+		if got := status(b.correlateKey(est.FreshnessPresentNonce, key, "https://db-nonce.tacra.example", "x509")); got != http.StatusConflict {
+			t.Fatalf("%s: %d, want 409", key, got)
+		}
+	}
+	if got := status(b.correlateKey(est.FreshnessAbsentNone, "", "https://db-none.tacra.example", "x509")); got != http.StatusOK {
+		t.Fatalf("a kind without a Handle: %d, want 200 (the RRP checks it)", got)
+	}
+}
