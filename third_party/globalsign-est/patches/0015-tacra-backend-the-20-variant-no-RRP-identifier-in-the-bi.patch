From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Serhii Nikolaichuk <nikolaichuk.s.f@gmail.com>
Date: Thu, 08 Oct 2026 14:38:26 -0500
Subject: [PATCH] tacra backend: the #20 variant, no RRP identifier in the
 binding

An RRP entry may say omit_rrp_id_in_binding: true, as the bench's RRP gateways can (the #20 variant: TACRA as if
Section 4.5 carried no RRP identifier). The server then computes the Verifier session's nonce with an empty
identifier, as the RRP recomputes the binding then; without this, a Passport exchange whose RRPs omit the identifier
could never match. The identifier is still checked against the RRP's attest-initiate answers, and still reported.

TestBoundID: the identifier the binding takes, with the option and without it.
---
diff --git a/internal/tacra/backend.go b/internal/tacra/backend.go
index 0077626..4e60a5c 100644
--- a/internal/tacra/backend.go
+++ b/internal/tacra/backend.go
@@ -61,6 +61,10 @@ type RRP struct {
 	CA    string `json:"ca"`     // CA of its TLS certificate
 	RRPID string `json:"rrp_id"` // the identifier it binds; checked against its attest-initiate answers
 	Mode  string `json:"mode"`   // "enroll" or "retrieve"
+	// OmitRRPIDInBinding, when set, makes this server compute the Verifier session's nonce with an empty RRP
+	// identifier, as the RRP gateway recomputes the binding then (the #20 variant: TACRA as if Section 4.5 carried
+	// none); the identifier is still checked against the RRP's attest-initiate answers.
+	OmitRRPIDInBinding bool `json:"omit_rrp_id_in_binding,omitempty"`
 	// RATSModel: "passport" (the default), this server obtains the Attestation Results; "background-check", the
 	// RRP does, from the Evidence this server forwards
 	RATSModel string `json:"rats_model,omitempty"`
@@ -235,6 +239,14 @@ func (b *Backend) route(target string) (string, RRP, error) {
 	return name, b.cfg.RRPs[name], nil
 }
 
+// boundID is the RRP identifier the binding value is computed with: the RRP's own, or none in the #20 variant.
+func (r RRP) boundID() string {
+	if r.OmitRRPIDInBinding {
+		return ""
+	}
+	return r.RRPID
+}
+
 // gatewayInitiation is an RRP gateway's answer to attest-initiate. RRPID is checked against this server's
 // configuration and goes no further: the Attester binds the identifier it holds itself.
 type gatewayInitiation struct {
@@ -493,7 +505,7 @@ func (b *Backend) forward(ctx context.Context, mode, kind, target, credentialTyp
 		if err != nil {
 			return "", RRP{}, secondLeg{}, err
 		}
-		nonce := bindingValue(handle, target, rrp.RRPID, subject)
+		nonce := bindingValue(handle, target, rrp.boundID(), subject)
 		if leg.EAR, err = b.verify(ctx, v, evidence, p, nonce); err != nil {
 			return "", RRP{}, secondLeg{}, err
 		}
diff --git a/internal/tacra/binding_test.go b/internal/tacra/binding_test.go
index 475b0d1..41079e0 100644
--- a/internal/tacra/binding_test.go
+++ b/internal/tacra/binding_test.go
@@ -23,3 +23,20 @@ func TestBindingValueTestVector(t *testing.T) {
 		t.Fatal("est.BindingDigest now gives the TACRA order: this backend can use it again")
 	}
 }
+
+// The #20 variant: with OmitRRPIDInBinding the server binds no identifier, as an RRP that omits it recomputes.
+func TestBoundID(t *testing.T) {
+	r := RRP{RRPID: "https://ca1.tacra.example"}
+	if r.boundID() != r.RRPID {
+		t.Errorf("boundID %q, want the RRP's own", r.boundID())
+	}
+	r.OmitRRPIDInBinding = true
+	if r.boundID() != "" {
+		t.Errorf("boundID %q with the identifier omitted, want none", r.boundID())
+	}
+	subject := []byte("a CSR")
+	if !bytes.Equal(bindingValue(nil, "https://db.tacra.example", r.boundID(), subject),
+		bindingValue(nil, "https://db.tacra.example", "", subject)) {
+		t.Error("the omitted identifier does not bind as the empty string")
+	}
+}
-- 
