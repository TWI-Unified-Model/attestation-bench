From 8069fa6ede05218048ed9979aa5843564cd660b0 Mon Sep 17 00:00:00 2001
From: Serhii Nikolaichuk <nikolaichuk.s.f@gmail.com>
Date: Thu, 1 Oct 2026 12:07:31 -0500
Subject: [PATCH 4/6] tacra backend: Background Check, the Evidence goes to the
 RRP

An RRP entry may say rats_model: background-check. For such an RRP the
backend opens no verifier session: the second leg carries the Evidence and
its media type, and the RRP asks the verifier itself (TACRA Goal 6; Mark
Novak in rats-tacra#6: "the Verifier would be contacted by SV and CA in
Background Check mode"). Passport stays the default. The Attester's
messages are the same in both.

backend_test.go: Passport opens one session whose nonce is the binding value
and forwards the EAR; Background Check opens none and forwards the Evidence;
an unknown model is a configuration error. Two mutants each make it fail.
---
 internal/tacra/backend.go      |  47 +++++++++---
 internal/tacra/backend_test.go | 132 +++++++++++++++++++++++++++++++++
 2 files changed, 167 insertions(+), 12 deletions(-)
 create mode 100644 internal/tacra/backend_test.go

diff --git a/internal/tacra/backend.go b/internal/tacra/backend.go
index 4977fdd..313f05f 100644
--- a/internal/tacra/backend.go
+++ b/internal/tacra/backend.go
@@ -1,8 +1,12 @@
 // Package tacra is an EST server backend for attested credential acquisition (draft-novak-lamps-tacra-est) that
 // talks to deployed components: Freshness Handles come from the RATS Relying Party (RRP) that will rely on the
-// Evidence, Evidence goes to a Veraison verification service (Passport model), and the Attestation Results go with
-// the request to that RRP, a Credential Authority or a Secret Vault. As the profile requires of an EST server, it
-// mints no Handle, appraises neither Evidence nor Attestation Results, and authorizes nothing: the RRP decides.
+// Evidence, a Credential Authority or a Secret Vault. For an RRP in the Passport model (the default) Evidence goes
+// to a Veraison verification service and the Attestation Results go with the request to the RRP; for an RRP in the
+// Background Check model the Evidence goes to the RRP, which asks the verifier itself (TACRA Goal 6; Mark Novak,
+// TheBankster/rats-tacra#6: "the Verifier would be contacted by SV and CA in Background Check mode. For Passport
+// mode, the interaction is driven by the CAS Server"). The Attester sees no difference. As the profile requires of an
+// EST server, it mints no Handle, appraises neither Evidence nor Attestation Results, and authorizes nothing: the RRP
+// decides.
 package tacra
 
 import (
@@ -53,6 +57,9 @@ type RRP struct {
 	CA    string `json:"ca"`     // CA of its TLS certificate
 	RRPID string `json:"rrp_id"` // the identifier it binds; checked against its attest-initiate answers
 	Mode  string `json:"mode"`   // "enroll" or "retrieve"
+	// RATSModel: "passport" (the default), this server obtains the Attestation Results; "background-check", the
+	// RRP does, from the Evidence this server forwards
+	RATSModel string `json:"rats_model,omitempty"`
 }
 
 type session struct {
@@ -101,6 +108,9 @@ func New(cfg Config) (*Backend, error) {
 		if r.Mode != est.MechanismEnroll && r.Mode != est.MechanismRetrieve {
 			return nil, fmt.Errorf("tacra: RRP %s: mode must be enroll or retrieve", name)
 		}
+		if r.RATSModel != "" && r.RATSModel != passport && r.RATSModel != backgroundCheck {
+			return nil, fmt.Errorf("tacra: RRP %s: rats_model must be passport or background-check", name)
+		}
 		if b.rrps[name], err = client(r.CA); err != nil {
 			return nil, err
 		}
@@ -324,13 +334,21 @@ func (b *Backend) verify(ctx context.Context, evidence []byte, profile string, n
 	return s.Result, nil
 }
 
+// The RATS models an RRP may run in (RRP.RATSModel).
+const (
+	passport        = "passport"
+	backgroundCheck = "background-check"
+)
+
 type secondLeg struct {
 	FreshnessKind  string `json:"freshness_kind"`
 	Target         string `json:"target"`
 	CredentialType string `json:"credential_type"`
 	Handle         string `json:"handle,omitempty"`
 	CredentialHint string `json:"credential_hint,omitempty"`
-	EAR            string `json:"ear"`
+	EAR            string `json:"ear,omitempty"`      // Passport: the verifier's Attestation Results
+	Evidence       string `json:"evidence,omitempty"` // Background Check: the Attester's Evidence, unopened
+	Profile        string `json:"profile,omitempty"`  // Background Check: its media type
 }
 
 func hint(h *string) string {
@@ -356,19 +374,24 @@ func (b *Backend) forward(ctx context.Context, mode, kind, target, credentialTyp
 	if err != nil {
 		return "", RRP{}, secondLeg{}, err
 	}
-	nonce := bindingValue(handle, target, rrp.RRPID, subject)
-	ear, err := b.verify(ctx, evidence, p, nonce)
-	if err != nil {
-		return "", RRP{}, secondLeg{}, err
+	leg := secondLeg{FreshnessKind: kind, Target: target, CredentialType: credentialType, CredentialHint: hint(hintp)}
+	if rrp.RATSModel == backgroundCheck {
+		// the RRP asks the verifier, with the binding value it recomputes; this server does not
+		leg.Evidence, leg.Profile = b64u(evidence), p
+	} else {
+		nonce := bindingValue(handle, target, rrp.RRPID, subject)
+		if leg.EAR, err = b.verify(ctx, evidence, p, nonce); err != nil {
+			return "", RRP{}, secondLeg{}, err
+		}
 	}
-	leg := secondLeg{FreshnessKind: kind, Target: target, CredentialType: credentialType, CredentialHint: hint(hintp), EAR: ear}
 	if len(handle) > 0 {
 		leg.Handle = b64u(handle)
 	}
 	return name, rrp, leg, nil
 }
 
-// EnrollCredential forwards Evidence to Veraison, then the CSR and Attestation Results to the Credential Authority.
+// EnrollCredential forwards Evidence to Veraison, then the CSR and Attestation Results to the Credential Authority;
+// in Background Check, the CSR and the Evidence to the Credential Authority.
 func (b *Backend) EnrollCredential(ctx context.Context, req *est.AttestedEnrollmentRequest, aps string, r *http.Request) (*x509.Certificate, error) {
 	name, _, leg, err := b.forward(ctx, est.MechanismEnroll, req.FreshnessKind, req.Target, req.CredentialType,
 		req.Handle, req.Evidence, req.Profile, req.CredentialHint, req.CSR)
@@ -399,8 +422,8 @@ func (b *Backend) RetrieveCredential(context.Context, *est.AttestedRetrievalRequ
 	return nil, fail(http.StatusInternalServerError, "RetrieveCredentialRaw serves attest-retrieve")
 }
 
-// RetrieveCredentialRaw forwards Evidence to Veraison, then CEKpub and the Attestation Results to the Secret Vault,
-// and returns the Vault's encrypted container unchanged.
+// RetrieveCredentialRaw forwards Evidence to Veraison, then CEKpub and the Attestation Results to the Secret Vault
+// (in Background Check, CEKpub and the Evidence), and returns the Vault's encrypted container unchanged.
 func (b *Backend) RetrieveCredentialRaw(ctx context.Context, req *est.AttestedRetrievalRequest, aps string, r *http.Request) ([]byte, error) {
 	name, _, leg, err := b.forward(ctx, est.MechanismRetrieve, req.FreshnessKind, req.Target, req.CredentialType,
 		req.Handle, req.Evidence, req.Profile, req.CredentialHint, req.CEKPub)
diff --git a/internal/tacra/backend_test.go b/internal/tacra/backend_test.go
new file mode 100644
index 0000000..17eaa9c
--- /dev/null
+++ b/internal/tacra/backend_test.go
@@ -0,0 +1,132 @@
+package tacra
+
+import (
+	"bytes"
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"io"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/globalsign/est"
+)
+
+// fakes records what the backend sends to the verifier and to the RRP.
+type fakes struct {
+	mu        sync.Mutex
+	verifier  []string // nonces of the sessions opened at the verifier (base64url)
+	enrollLeg []map[string]any
+}
+
+func caFile(t *testing.T, srv *httptest.Server) string {
+	p := filepath.Join(t.TempDir(), "ca.pem")
+	if err := os.WriteFile(p, pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: srv.Certificate().Raw}), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+// TestRATSModels: for an RRP in the Passport model the backend opens the verifier session, with the binding value
+// as its nonce, and forwards the Attestation Results; for an RRP in the Background Check model it never asks the
+// verifier and forwards the Evidence and its media type. The Attester's messages are the same in both.
+func TestRATSModels(t *testing.T) {
+	const target, rrpID, evidenceType = "https://db.tacra.example", "https://ca1.tacra.example", "application/vnd.veraison.tsm-report+cbor"
+	f := &fakes{}
+	verifier := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch {
+		case r.Method == http.MethodPost && r.URL.Path == "/challenge-response/v1/newSession":
+			f.mu.Lock()
+			f.verifier = append(f.verifier, r.URL.Query().Get("nonce"))
+			f.mu.Unlock()
+			w.Header().Set("Location", "session/1")
+			w.WriteHeader(http.StatusCreated)
+		case r.Method == http.MethodPost:
+			_ = json.NewEncoder(w).Encode(map[string]string{"status": "complete", "result": "header.claims.signature"})
+		default:
+			w.WriteHeader(http.StatusNoContent)
+		}
+	}))
+	defer verifier.Close()
+	key, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	der, _ := x509.CreateCertificate(rand.Reader, &x509.Certificate{SerialNumber: big.NewInt(1),
+		Subject: pkix.Name{CommonName: "workload.tacra.example"}, NotBefore: time.Now(), NotAfter: time.Now().Add(time.Hour)},
+		&x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "test CA"}}, &key.PublicKey, key)
+	handle := bytes.Repeat([]byte{0x42}, 32)
+	rrp := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		switch r.URL.Path {
+		case "/tacra/v1/initiate":
+			_ = json.NewEncoder(w).Encode(map[string]any{"freshness_kind": est.FreshnessPresentNonce, "handle": b64u(handle),
+				"rrp_id": rrpID, "expires_in": 300, "mode": est.MechanismEnroll})
+		case "/tacra/v1/enroll":
+			var leg map[string]any
+			_ = json.Unmarshal(body, &leg)
+			f.mu.Lock()
+			f.enrollLeg = append(f.enrollLeg, leg)
+			f.mu.Unlock()
+			_ = json.NewEncoder(w).Encode(map[string]any{"certificate_chain": []string{b64u(der)}})
+		}
+	}))
+	defer rrp.Close()
+
+	evidence := []byte("a TSM report, unopened by the EST server")
+	csr := []byte("the CSR's DER")
+	for _, model := range []string{"", passport, backgroundCheck} {
+		cfg := Config{RRPs: map[string]RRP{"ca1": {URL: rrp.URL, CA: caFile(t, rrp), RRPID: rrpID, Mode: est.MechanismEnroll, RATSModel: model}},
+			Targets: map[string]string{target: "ca1"}, AcceptableEvidence: []string{evidenceType}}
+		cfg.Veraison.URL, cfg.Veraison.CA = verifier.URL, caFile(t, verifier)
+		b, err := New(cfg)
+		if err != nil {
+			t.Fatal(err)
+		}
+		f.verifier, f.enrollLeg = nil, nil
+		init, err := b.InitiateRemoteAttestation(context.Background(), target, "x509", "", nil)
+		if err != nil || !bytes.Equal(init.Handle, handle) {
+			t.Fatalf("%q: initiate: %v", model, err)
+		}
+		if _, err := b.EnrollCredential(context.Background(), &est.AttestedEnrollmentRequest{Target: target, CredentialType: "x509",
+			FreshnessKind: est.FreshnessPresentNonce, Handle: handle, CSR: csr, Evidence: evidence, Profile: evidenceType}, "", nil); err != nil {
+			t.Fatalf("%q: enroll: %v", model, err)
+		}
+		if len(f.enrollLeg) != 1 {
+			t.Fatalf("%q: the RRP received %d second legs", model, len(f.enrollLeg))
+		}
+		leg := f.enrollLeg[0]
+		if model == backgroundCheck {
+			if len(f.verifier) != 0 {
+				t.Errorf("background-check: the EST server opened %d verifier sessions; it must open none", len(f.verifier))
+			}
+			if leg["evidence"] != b64u(evidence) || leg["profile"] != evidenceType || leg["ear"] != nil {
+				t.Errorf("background-check: the RRP received %v; want the Evidence and its media type, no EAR", leg)
+			}
+			continue
+		}
+		bv := bindingValue(handle, target, rrpID, csr)
+		if len(f.verifier) != 1 || f.verifier[0] != base64.URLEncoding.EncodeToString(bv) {
+			t.Errorf("%q: verifier sessions %v, want one with the binding value", model, f.verifier)
+		}
+		if leg["ear"] != "header.claims.signature" || leg["evidence"] != nil {
+			t.Errorf("%q: the RRP received %v; want the Attestation Results, no Evidence", model, leg)
+		}
+	}
+	if _, err := New(Config{RRPs: map[string]RRP{"ca1": {URL: rrp.URL, CA: caFile(t, rrp), RRPID: rrpID, Mode: est.MechanismEnroll,
+		RATSModel: "both"}}, AcceptableEvidence: []string{evidenceType}, Veraison: struct {
+		URL string `json:"url"`
+		CA  string `json:"ca"`
+	}{verifier.URL, caFile(t, verifier)}}); err == nil {
+		t.Error("rats_model \"both\" was accepted")
+	}
+}
