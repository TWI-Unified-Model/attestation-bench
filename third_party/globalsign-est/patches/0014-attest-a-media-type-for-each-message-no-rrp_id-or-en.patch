@@ -3,13 +3,12 @@ package est
 import (
 	"encoding/base64"
 	"encoding/json"
-	"strings"
+	"errors"
 )
 
-// B64URL is a byte string of the attested-acquisition envelopes. JSON carries it as unpadded base64url, as
