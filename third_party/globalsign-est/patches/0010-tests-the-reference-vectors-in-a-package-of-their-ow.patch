From 7468503a8ea6bad3f4143b834b256aec80ac55f5 Mon Sep 17 00:00:00 2001
From: Serhii Nikolaichuk <nikolaichuk.s.f@gmail.com>
Date: Wed, 7 Oct 2026 10:05:03 -0500
Subject: [PATCH] tests: the reference vectors in a package of their own

The tests on the reference implementation's messages were in the est
package's directory, so their test binary also held the package's
upstream tests, whose init creates a mock CA, which ran however the
tests were selected. They move, with their vectors, to
internal/refvectors: a package of their own, whose test binary holds no
mock (go list -deps -test).
---
 .../refvectors/attest_ref_interop_test.go                     | 2 +-
 internal/refvectors/doc.go                                    | 4 ++++
 .../refvectors/testdata}/tacra-est-ref-vectors-sev-snp.json   | 0
 3 files changed, 5 insertions(+), 1 deletion(-)
 rename attest_ref_interop_test.go => internal/refvectors/attest_ref_interop_test.go (99%)
 create mode 100644 internal/refvectors/doc.go
 rename {testdata => internal/refvectors/testdata}/tacra-est-ref-vectors-sev-snp.json (100%)

diff --git a/attest_ref_interop_test.go b/internal/refvectors/attest_ref_interop_test.go
similarity index 99%
rename from attest_ref_interop_test.go
rename to internal/refvectors/attest_ref_interop_test.go
index 5a85123..49d3ef4 100644
--- a/attest_ref_interop_test.go
+++ b/internal/refvectors/attest_ref_interop_test.go
@@ -1,4 +1,4 @@
-package est_test
+package refvectors_test
 
 import (
 	"bytes"
diff --git a/internal/refvectors/doc.go b/internal/refvectors/doc.go
new file mode 100644
index 0000000..d83f22e
--- /dev/null
+++ b/internal/refvectors/doc.go
@@ -0,0 +1,4 @@
+// Package refvectors holds the tests of the est package's attest-* messages on the messages of the reference
+// implementation of draft-novak-lamps-tacra-est. They are a package of their own so that their test binary holds
+// none of the est package's upstream tests, whose init creates a mock CA.
+package refvectors
diff --git a/testdata/tacra-est-ref-vectors-sev-snp.json b/internal/refvectors/testdata/tacra-est-ref-vectors-sev-snp.json
similarity index 100%
rename from testdata/tacra-est-ref-vectors-sev-snp.json
rename to internal/refvectors/testdata/tacra-est-ref-vectors-sev-snp.json
