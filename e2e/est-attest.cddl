; The JSON messages of the attest-* resources (RFC 8610; RFC 8259).
; A byte string is carried as a text string holding its unpadded
; base64url encoding (RFC 4648, Section 5), as the control .b64u of
; RFC 9741 defines.

attestation-initiation-response = {
  initiation-freshness,
  initiation-mode,
  ? acceptable_evidence: [+ text],
}

initiation-freshness = (
  freshness_kind: "present-nonce",
  handle: text .b64u (bytes .size (16..64)),
  ? expires_in: uint,
//
  freshness_kind: "present-epoch",
  handle: text .b64u (bytes .size (8..64)),
  ? expires_in: uint,
//
  freshness_kind: "absent-timestamp",
  ? max_age: uint,
//
  freshness_kind: "absent-epoch" / "absent-none",
)

initiation-mode = (
  mode: "enroll",
  acceptable_csk: [+ text],
//
  mode: "retrieve",
  acceptable_cek: [+ text],
)

attested-enrollment-request = {
  request-common,
  request-freshness,
  csr: text .b64u bytes,
}

attested-retrieval-request = {
  request-common,
  request-freshness,
  cek_pub: text .b64u bytes,
}

request-common = (
  target: text,
  ? credential_type: text,
  evidence: text .b64u bytes,
  ? profile: text,
  binding: binding,
  ? credential_hint: text,
)

request-freshness = (
  freshness_kind: "absent-none"
//
  freshness_kind: "absent-timestamp",
  handle: text .b64u (bytes .size 8),
//
  freshness_kind: "absent-epoch" / "present-epoch",
  handle: text .b64u (bytes .size (8..64)),
//
  freshness_kind: "present-nonce",
  handle: text .b64u (bytes .size (16..64)),
)

binding = {
  method: "binding-input",
  hash: "sha512",
}

; --- the container of TACRA, Sealing the Released Credential ---
encrypted-credential-bundle = {
  container-members,
}

container-members = (
  container: "hpke-base",
  suite: {
    kem: text,
    kdf: text,
    aead: text,
  },
  enc: text .b64u bytes,
  ciphertext: text .b64u bytes,
  aad: {
    group_id: text,
    target: text .b64u bytes,
    ? handle: text .b64u bytes,
    ? credential_hint: text,
  },
)

; --- the response of attest-retrieve on the bench ---
; The Secret Vault of the bench signs the container when its policy for
; the Target says so, and then adds the origin member. TACRA does not
; define that member.
attest-retrieve-response = encrypted-credential-bundle
                         / signed-credential-bundle

signed-credential-bundle = {
  container-members,
  origin: {
    alg: "ECDSA-P256-SHA256",
    signature: text .b64u bytes,
  },
}

credential-bundle = {
  credential_items: [+ credential-item],
  ? metadata: { * text => any },
}

credential-item = {
  type: text,
  value: text .b64u bytes,
  ? format: text,
  ? kid: text,
  ? purpose: [+ text],
  ? algorithm: text,
  ? exportable: bool,
  ? shared: bool,
}
